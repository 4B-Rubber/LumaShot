VS_VERSION_INFO VERSIONINFO
FILEVERSION LUMASHOT_VERSION_MAJOR,LUMASHOT_VERSION_MINOR,LUMASHOT_VERSION_PATCH,0
PRODUCTVERSION LUMASHOT_VERSION_MAJOR,LUMASHOT_VERSION_MINOR,LUMASHOT_VERSION_PATCH,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", "LumaShot"
            VALUE "FileDescription", "LumaShot 截图与标注"
            VALUE "FileVersion", LUMASHOT_VERSION_TEXT
            VALUE "InternalName", "LumaShot"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "LumaShot.exe"
            VALUE "ProductName", "LumaShot"
            VALUE "ProductVersion", LUMASHOT_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END