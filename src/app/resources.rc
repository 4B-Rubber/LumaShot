    CONTROL "恢复本页默认", 113, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 1, 1
    CONTROL "取消", IDCANCEL, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 1, 1
    CONTROL "保存", IDOK, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 1, 1
    CONTROL "×", 114, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 1, 1
