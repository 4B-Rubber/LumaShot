#include <windows.h>
#include <commctrl.h>
#include "resource.h"
#include "lumashot_version.h"
IDI_LUMASHOT ICON "app.ico"
#pragma code_page(65001)
1 RT_MANIFEST "app.manifest"
100 DIALOGEX 0, 0, 333, 379
// WS_THICKFRAME + WS_EX_NOREDIRECTIONBITMAP (0x00200000): DWM system backdrop, frames presented through
// DirectComposition; the frame has zero size (WM_NCCALCSIZE returns 0).
STYLE DS_SETFONT | WS_POPUP | WS_CLIPCHILDREN | WS_THICKFRAME
EXSTYLE WS_EX_CONTROLPARENT | 0x00200000L
// Window text is set at runtime: CAPTION implicitly adds WS_CAPTION.
FONT 10, "Microsoft YaHei UI"
BEGIN
    CONTROL "常规", 135, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 1, 1
    CONTROL "快捷键", 136, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 1, 1
    CONTROL "截图", 137, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 1, 1
    CONTROL "工具面板", 138, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 1, 1
