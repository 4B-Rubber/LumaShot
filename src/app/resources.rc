    CONTROL "贴图", 140, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 1, 1
    CONTROL "外观", 149, "Button", BS_OWNERDRAW | WS_TABSTOP, 0, 0, 1, 1
